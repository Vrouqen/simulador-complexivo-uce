# ---------------------------------------------------------------------------
# Copia este archivo como .env.local (desarrollo) y configura lo mismo en
# Vercel → Project → Settings → Environment Variables (producción).
# ---------------------------------------------------------------------------

# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (puerto 6543)
# Añade ?sslmode=require al final.
DATABASE_URL=postgres://postgres.TU_REF:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Solo para npm run db:migrate / db:seed desde tu PC (opcional). "Session pooler" (puerto 5432).
# MIGRATE_DATABASE_URL=postgres://postgres.TU_REF:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# Secreto para firmar sesiones y códigos. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
# ¡Si lo cambias, todos los códigos de activación pendientes dejan de valer!
SESSION_SECRET=

# Tu acceso al panel /admin
ADMIN_EMAIL=tu-correo@gmail.com
ADMIN_PASSWORD=una-contraseña-larga-y-unica

# Datos públicos de venta (se muestran en la página principal)
LICENSE_PRICE=$15
CONTACT_WHATSAPP=593999999999
CONTACT_EMAIL=
# Usa \n para separar líneas
PAYMENT_INFO=Banco Pichincha · Cuenta de ahorros 0000000000\nTitular: Tu Nombre · CI 0000000000\nLuego envía la solicitud con el número de comprobante.

# Tamaño del pool de conexiones (3 en Vercel; 1 con PGlite local)
# DB_POOL_MAX=3
